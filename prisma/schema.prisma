// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── PRODUITS CATALOGUE STANDARD ────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  brand       String
  description String   @db.Text
  price       Decimal  @db.Decimal(10, 2) // 40.00 EUR TTC
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  images      String[] // URLs Vercel Blob, ordonnées
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants ProductVariant[]

  @@map("products")
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  sku        String   @unique // DF-{BRAND}-{MODEL}-001
  stock      Int      @default(0)
  stockAlert Int      @default(5)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@map("product_variants")
}

// ─── CONFIGURATEUR D'ART SUR-MESURE (ATELIER) ──────────────────────────────

enum ConfiguratorGroupKey {
  DIMENSION
  FINISH
  CAR
  SCALE
}

model ConfiguratorGroup {
  id        String               @id @default(cuid())
  key       ConfiguratorGroupKey @unique
  name      String
  sortOrder Int                  @default(0)
  active    Boolean              @default(true)
  options   ConfiguratorOption[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@map("configurator_groups")
}

model ConfiguratorOption {
  id              String                  @id @default(cuid())
  groupId         String
  group           ConfiguratorGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  slug            String
  name            String
  subtitle        String?
  description     String?
  imageUrl        String?
  textureUrl      String?
  priceDeltaCents Int                     @default(0)
  active          Boolean                 @default(true)
  sortOrder       Int                     @default(0)
  metadata        Json?
  cars            ConfiguratorCarOption[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([groupId, slug])
  @@index([groupId, active, sortOrder])
  @@map("configurator_options")
}

model CarModel {
  id         String                  @id @default(cuid())
  brand      String
  model      String
  generation String?
  yearFrom   Int?
  yearTo     Int?
  era        String?
  imageUrl   String?
  active     Boolean                 @default(true)
  options    ConfiguratorCarOption[]
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@index([brand, model])
  @@map("car_models")
}

model ConfiguratorCarOption {
  id              String             @id @default(cuid())
  optionId        String
  carId           String
  option          ConfiguratorOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  car             CarModel           @relation(fields: [carId], references: [id], onDelete: Cascade)
  priceDeltaCents Int                @default(0)
  stockQty        Int                @default(0)
  active          Boolean            @default(true)

  @@unique([optionId, carId])
  @@map("configurator_car_options")
}

model ConfiguratorPricingRule {
  id              String   @id @default(cuid())
  name            String
  dimensionId     String?
  finishId        String?
  carId           String?
  scaleId         String?
  fixedDeltaCents Int      @default(0)
  multiplier      Decimal? @db.Decimal(8, 4)
  priority        Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("configurator_pricing_rules")
}

// ─── COMMANDES & SNAPSHOTS IMMUABLES ────────────────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  REFUNDED
  CANCELLED
}

enum OrderReturnPolicy {
  STANDARD_14_DAYS
  CUSTOM_PRODUCT_EXCEPTION
}

model Order {
  id          String            @id @default(cuid())
  orderNumber String            @unique // DF-2026-00001
  status      OrderStatus       @default(PENDING)
  returnPolicy OrderReturnPolicy @default(STANDARD_14_DAYS)

  // Client (guest checkout)
  customerEmail     String
  customerFirstName String
  customerLastName  String
  customerPhone     String?

  // Adresse de livraison
  shippingAddress    String
  shippingCity       String
  shippingPostalCode String
  shippingCountry    String @default("FR")

  // Adresse de facturation
  billingAddress     String?
  billingCity        String?
  billingPostalCode  String?
  billingCountry     String?

  // Montants
  subtotal     Decimal @db.Decimal(10, 2)
  shippingCost Decimal @db.Decimal(10, 2)
  taxAmount    Decimal @db.Decimal(10, 2)
  total        Decimal @db.Decimal(10, 2)

  // Stripe
  stripeSessionId       String? @unique
  stripePaymentIntentId String?

  // Facturation
  invoiceNumber String?   @unique
  invoicePdfUrl String?

  // Expédition Colissimo
  trackingNumber String?
  carrier        String?   @default("Colissimo")
  shippedAt      DateTime?
  deliveredAt    DateTime?

  // Interne
  internalNote String? @db.Text

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     OrderItem[]

  @@index([customerEmail])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id                    String   @id @default(cuid())
  orderId               String
  productId             String?
  variantId             String?
  sku                   String?
  productName           String
  unitPrice             Decimal  @db.Decimal(10, 2)
  quantity              Int
  total                 Decimal  @db.Decimal(10, 2)
  configurationSnapshot Json?    // Snapshot complet immuable si création sur-mesure

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

// ─── COMPTEURS TRANSACTIONNELS IMMUABLES ────────────────────────────────────

model InvoiceSequence {
  year      Int @id
  nextValue Int @default(1)

  @@map("invoice_sequences")
}

model InvoiceCounter {
  id         String @id @default(cuid())
  year       Int    @unique
  lastNumber Int    @default(0)

  @@map("invoice_counters")
}

model OrderCounter {
  id         String @id @default(cuid())
  year       Int    @unique
  lastNumber Int    @default(0)

  @@map("order_counters")
}

// ─── STOCK LEDGER & RÉSERVATIONS TEMPORAIRES ────────────────────────────────

enum StockMovementType {
  MANUAL
  ORDER
  RESTOCK
  REFUND
  SALE
  MANUAL_ADJUSTMENT
  DAMAGE
  RETURN
  CORRECTION
}

model StockMovement {
  id        String            @id @default(cuid())
  variantId String?
  carId     String?
  type      StockMovementType
  quantity  Int               // Positif = entrée, négatif = sortie
  beforeQty Int               @default(0)
  afterQty  Int               @default(0)
  orderId   String?
  note      String?
  reason    String?
  createdBy String?
  createdAt DateTime          @default(now())

  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([variantId, createdAt])
  @@map("stock_movements")
}

model StockReservation {
  id              String   @id @default(cuid())
  productId       String
  quantity        Int
  expiresAt       DateTime
  status          String   @default("PENDING") // PENDING, CONFIRMED, EXPIRED
  stripeSessionId String?
  createdAt       DateTime @default(now())

  @@index([productId, expiresAt])
  @@map("stock_reservations")
}

// ─── CONFORMITÉ RÉGLEMENTAIRE (REP / DEEE / FACTURATION 2026) ───────────────

model ComplianceProfile {
  id                     String   @id @default(cuid())
  eeeIdu                 String?  // Identifiant Unique filière EEE (ADEME)
  furnitureIdu           String?  // IDU Éléments d'ameublement (si cadre bois)
  packagingIdu           String?  // IDU Emballages ménagers
  ecoParticipationCents  Int      @default(14) // Ex: 0.14 € TTC inclus pour les micro-LEDs
  ceApplicable           Boolean  @default(true)
  vatNumber              String?  // Numéro de TVA Intracommunautaire
  siren                  String?
  updatedAt              DateTime @updatedAt

  @@map("compliance_profiles")
}

// ─── AUDIT TRAIL ────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ─── WEBHOOKS (IDEMPOTENCE STRIPE) & LOGS ───────────────────────────────────

model WebhookEvent {
  id          String    @id
  type        String
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@map("webhook_events")
}

model IntegrationLog {
  id        String   @id @default(cuid())
  service   String
  action    String
  status    String
  payload   Json?
  response  Json?
  error     String?
  createdAt DateTime @default(now())

  @@map("integration_logs")
}

model StripeEvent {
  id          String   @id // event.id Stripe
  type        String
  processedAt DateTime @default(now())

  @@index([type])
  @@map("stripe_events")
}

// ─── AUTH (Auth.js v5) ───────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          String    @default("ADMIN")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}
